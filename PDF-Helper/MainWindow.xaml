<Window x:Class="PDF_Helper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_Helper"
        mc:Ignorable="d"
        Title="PDF-Helper" Height="600" Width="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="20,40,0,0" >
            <TextBox Text="Đường dẫn thư mục :" Height="30" Margin="0,0,0,0" Width="600" FontSize="14"/>
            <Button Click="FolderSelect_Click" Content="Chọn thư mục" Height="30" Margin="20,0,0,0" Width="140" FontSize="14" Background="OrangeRed" Foreground="White"/>
        </StackPanel>
        <Button Click="FileSelect_Click" Content="Chọn file" Height="30" Margin="640,20,0,0" Width="140" FontSize="14" Background="Blue" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock HorizontalAlignment="Left" Height="30" Margin="40,20,0,0" TextWrapping="Wrap" Text="Trạng thái :" FontSize="14"/>
        <Label x:Name="statusLabel" HorizontalAlignment="Left" Margin="40,0,0,0" FontSize="14" BorderBrush="Black" BorderThickness="1" Height="280" Width="717"/>

    </StackPanel>
</Window>
