<Window x:Class="PDF_Helper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_Helper"
        mc:Ignorable="d"
        Title="PDF-Helper" Height="600" Width="800"
        Loaded="Window_Loaded" Unloaded="Window_Unloaded">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="20,30,0,0" >
            <Button Click="FolderSelect_Click" Content="Chọn thư mục" Height="30" Margin="0,0,0,0" Width="140" FontSize="14" Background="OrangeRed" Foreground="White"/>
            <TextBox x:Name="FolderPathTxb"
                     Text="{x:Static local:MainWindow.NO_FOLDER_PATH}" Height="30" Margin="20,0,0,0" Width="600" FontSize="14"
                     GotFocus="PathTxb_GotFocus"
                     LostFocus="PathTxb_LostFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="20,30,0,0" >
            <Button Click="FileSelect_Click" Content="Chọn file" Height="30" Margin="0,0,0,0" Width="140" FontSize="14" Background="Blue" Foreground="White" HorizontalAlignment="Left"/>
            <TextBox x:Name="FilePathTxb"
                 Text="{x:Static local:MainWindow.NO_FILE_PATH}" Height="30" Margin="20,0,0,0" Width="600" FontSize="14"
                 GotFocus="PathTxb_GotFocus"
                 LostFocus="PathTxb_LostFocus"/>
        </StackPanel>
        <Button Click="OCR_Click" Content="Bắt đầu đọc ký tự" Height="30" Margin="20,30,0,0" Width="140" FontSize="14" Background="ForestGreen" Foreground="White" HorizontalAlignment="Left"/>
        <TextBlock HorizontalAlignment="Left" Height="30" Margin="40,20,0,0" TextWrapping="Wrap" Text="Trạng thái :" FontSize="14"/>
        <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4"
            Padding="5"
            Width="720"
            Height="300"
            Margin="40,00,0,0"
            HorizontalAlignment="Left">
            <ScrollViewer x:Name="scrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="statusLabel"
                   TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </StackPanel>
</Window>
